# Copy this file to .env and fill in your values.

# Personal access token.
#   Use a classic token (ghp_...) with the "project" scope (plus "repo" to add private-repo issues).
#   Fine-grained tokens (github_pat_...) only work for org-owned projects, not user-owned ones.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Login of the user or organization that owns the project.
GITHUB_PROJECT_OWNER=savasozkan

# "user" or "org"
GITHUB_PROJECT_OWNER_TYPE=user

# Project number from the URL: github.com/users/<owner>/projects/<number>
GITHUB_PROJECT_NUMBER=5

# Repository where `task-agent plan` creates the master issue and its sub-issues.
GITHUB_REPO=owner/repo-name

# Optional: local AI model used by `task-agent plan`
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_VISION_MODEL=qwen3-vl:4b   # describes drawings in PDFs
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b   # finds similar existing tasks
# OLLAMA_HOST=http://localhost:11434
